root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml,toml,json,cff,R}]
indent_size = 2

[*.{sh,sbatch}]
indent_size = 2

[*.ipynb]
insert_final_newline = unset
trim_trailing_whitespace = unset

[Makefile]
indent_style = tab
